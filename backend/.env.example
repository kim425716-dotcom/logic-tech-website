# Server
PORT=8080
NODE_ENV=development

# Frontend origin for CORS (adjust for production)
FRONTEND_URL=http://localhost:5500

# Admin seed account (min 16 chars for password)
ADMIN_NAME=Logic Tech Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP (optional — required for password reset emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@logictech.io

# Public URL for reset links
# APP_URL=https://logictech.io
