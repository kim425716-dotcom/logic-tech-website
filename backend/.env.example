# Server
PORT=8080
NODE_ENV=production

# Production domain
FRONTEND_URL=https://logictech.co.ke
PUBLIC_URL=https://logictech.co.ke
APP_URL=https://logictech.co.ke

# Admin seed account (min 16 chars for password)
ADMIN_NAME=Logic Tech Admin
ADMIN_EMAIL=admin@logictech.co.ke
ADMIN_PASSWORD=

# Session secret — long random string (required)
SESSION_SECRET=

# SMTP (required for password reset emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=hello@logictech.co.ke
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@logictech.co.ke
