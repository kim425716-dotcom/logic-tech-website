# Server
PORT=8080
NODE_ENV=production

# Production domain
FRONTEND_URL=https://logictech.co.ke
PUBLIC_URL=https://logictech.co.ke
APP_URL=https://logictech.co.ke

# Admin seed account (min 16 chars for password)
ADMIN_NAME=Logic Tech Admin
ADMIN_EMAIL=admin@logictech.co.ke
ADMIN_PASSWORD=

# Session secret — long random string (required)
SESSION_SECRET=

# ── SMTP Email Transport (cPanel Webmail) ───────────────────────────
SMTP_HOST=mail.logictech.co.ke
SMTP_PORT=465
SMTP_USER=info@logictech.co.ke
SMTP_PASSWORD=your_cpanel_email_password
SMTP_FROM=Logic Tech <info@logictech.co.ke>
SMTP_REJECT_UNAUTHORIZED=false

# ── M-Pesa Daraja API (Safaricom) ─────────────────────────────────────
# Your receiving line: 0702588886 (register as Lipa na M-Pesa Till at Safaricom)
# Get developer credentials at: https://developer.safaricom.co.ke
#
# Sandbox testing: set ENVIRONMENT=sandbox, SHORTCODE=174379
# Production live: set ENVIRONMENT=production, SHORTCODE=your_till_number
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_RECEIVER_PHONE=254702588886
MPESA_CALLBACK_URL=https://logictech.co.ke/api/shop/mpesa/callback

# ── Card Payment Gateway (Flutterwave v3) ─────────────────────────────
# Optional: Get live/test keys at https://dashboard.flutterwave.com
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx-X
FLW_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxx
FLW_WEBHOOK_HASH=your_webhook_secret_hash
