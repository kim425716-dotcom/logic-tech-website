# Apache cPanel Configuration for Logic Tech

# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home3/logictec/nodeapp"
PassengerBaseURI "/"
PassengerNodejs "/home3/logictec/nodevenv/nodeapp/20/bin/node"
PassengerAppType node
PassengerStartupFile app.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# Deny access to sensitive files
<FilesMatch "(\.env|\.db|package\.json|package-lock\.json|\.gitignore|\.git)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Security and Routing
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct web access to backend source, storage, node_modules, and git
    RewriteRule ^(backend|storage|node_modules|\.git)(/|$) - [F,L]

    # Clean HTML URLs (e.g. /about -> /about.html)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Cache-Control: prevent browsers and LiteSpeed from serving stale CSS and JS
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

